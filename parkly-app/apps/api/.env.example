# Copy to .env for local dev. Real values live in Vercel env vars (Sensitive), never in git.
APP_ENV=local
LOG_LEVEL=debug
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
# Local value matches supabase/seed.sql. Hosted: openssl rand -hex 32, same value in Supabase Vault.
JOB_HMAC_SECRET=local-dev-job-secret-change-me-0123456789
# Local Supabase (supabase start). Hosted: Supavisor transaction-mode URL as parkly_api.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Required outside local
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# EU region DSN (de.sentry.io); optional locally
SENTRY_DSN=
