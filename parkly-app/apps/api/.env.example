# Copy to .env for local dev (optional: the API has safe local defaults).
# Real values live in Vercel env vars (marked Sensitive), never in git.
APP_ENV=local
LOG_LEVEL=debug
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Local value matches supabase/seed.sql. Hosted: openssl rand -hex 32, same value in Supabase Vault.
JOB_HMAC_SECRET=local-dev-job-secret-change-me-0123456789

# Local Supabase (supabase start). Hosted: Supavisor transaction-mode URL as parkly_api (port 6543).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase project URL and publishable key (Dashboard → Project Settings → API Keys).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=

# Send SMS Hook secret (Dashboard → Authentication → Hooks → Send SMS → secret, "v1,whsec_…").
SUPABASE_SMS_HOOK_SECRET=

# Lookup-hash pepper (≥ 32 chars) and field-encryption key (32 bytes, base64):
#   openssl rand -hex 32        → HASH_PEPPER_V1
#   openssl rand -base64 32     → ENC_KEY_V1
HASH_PEPPER_V1=
ENC_KEY_V1=
ENC_KEY_CURRENT=v1

# fake until Termii approves the sender ID; must be termii in prod.
SMS_PROVIDER=fake
TERMII_API_KEY=
TERMII_SENDER_ID=

# Supabase Storage (server-only secret key, sb_secret_…: Dashboard → Project Settings → API Keys).
# Never put this key in a client app or a NEXT_PUBLIC_/EXPO_PUBLIC_ variable.
STORAGE_PROVIDER=fake
SUPABASE_SECRET_KEY=

# Paystack bank resolve + subaccounts. Test keys only (sk_test_…) outside prod; live keys are refused.
SETTLEMENT_PROVIDER=fake
PAYSTACK_SECRET_KEY=

# PDF virus scanning: only the fake exists until ADR 0013 picks a vendor (prod refuses the fake).
MALWARE_SCANNER=fake

# Address search (ADR 0014): LocationIQ access token (pk.…). Server-only secret; never in a client.
# Empty = a short fake list of Lagos places answers (local/dev). Required in prod.
LOCATIONIQ_API_KEY=

# Required outside local
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# EU region DSN (de.sentry.io); optional locally
SENTRY_DSN=
