{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["dub1"],
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm turbo run build --filter=@parkly/contracts --filter=@parkly/db --filter=@parkly/domain",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "**": false
    }
  }
}
