{
  "openapi": "3.1.0",
  "info": {
    "title": "Parkly API",
    "version": "0.1.0"
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Supabase Auth access token (ES256)"
      }
    },
    "schemas": {},
    "parameters": {}
  },
  "paths": {
    "/health/live": {
      "get": {
        "tags": [
          "ops"
        ],
        "responses": {
          "200": {
            "description": "Process is up",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "ops"
        ],
        "responses": {
          "200": {
            "description": "Dependencies reachable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "degraded"
                      ]
                    },
                    "checks": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string",
                        "enum": [
                          "ok",
                          "fail",
                          "skipped"
                        ]
                      }
                    }
                  },
                  "required": [
                    "status",
                    "checks"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "A dependency is down",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "degraded"
                      ]
                    },
                    "checks": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string",
                        "enum": [
                          "ok",
                          "fail",
                          "skipped"
                        ]
                      }
                    }
                  },
                  "required": [
                    "status",
                    "checks"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/otp/precheck": {
      "post": {
        "tags": [
          "auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "phone": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20
                  },
                  "deviceId": {
                    "type": "string",
                    "format": "uuid"
                  }
                },
                "required": [
                  "phone",
                  "deviceId"
                ]
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "OK to request a code"
          }
        }
      }
    },
    "/v1/auth/bootstrap": {
      "post": {
        "tags": [
          "auth"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "deviceId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "platform": {
                    "type": "string",
                    "enum": [
                      "ANDROID",
                      "IOS",
                      "WEB",
                      "PWA"
                    ]
                  },
                  "appVersion": {
                    "type": "string",
                    "maxLength": 32
                  }
                },
                "required": [
                  "deviceId",
                  "platform"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed-in profile",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "firstName": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "lastName": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "phoneLast4": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "ACTIVE",
                            "LOCKED",
                            "SUSPENDED",
                            "PENDING_DELETION",
                            "DELETED"
                          ]
                        },
                        "roles": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "role": {
                                "type": "string",
                                "enum": [
                                  "DRIVER",
                                  "OPERATOR_OWNER",
                                  "OPERATOR_MANAGER",
                                  "OPERATOR_ATTENDANT",
                                  "ADMIN_SUPPORT",
                                  "ADMIN_OPS",
                                  "ADMIN_FINANCE",
                                  "ADMIN_COMPLIANCE",
                                  "SUPER_ADMIN"
                                ]
                              },
                              "operatorId": {
                                "type": [
                                  "string",
                                  "null"
                                ],
                                "format": "uuid"
                              }
                            },
                            "required": [
                              "role",
                              "operatorId"
                            ]
                          }
                        },
                        "profileComplete": {
                          "type": "boolean"
                        },
                        "consents": {
                          "type": "object",
                          "properties": {
                            "termsVersion": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "privacyVersion": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "marketing": {
                              "type": "boolean"
                            }
                          },
                          "required": [
                            "termsVersion",
                            "privacyVersion",
                            "marketing"
                          ]
                        },
                        "currentLegalVersions": {
                          "type": "object",
                          "properties": {
                            "terms": {
                              "type": "string"
                            },
                            "privacy": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "terms",
                            "privacy"
                          ]
                        }
                      },
                      "required": [
                        "id",
                        "firstName",
                        "lastName",
                        "phoneLast4",
                        "status",
                        "roles",
                        "profileComplete",
                        "consents",
                        "currentLegalVersions"
                      ]
                    },
                    "isNewUser": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "user",
                    "isNewUser"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/sessions/revoke": {
      "post": {
        "tags": [
          "auth"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "scope": {
                    "type": "string",
                    "enum": [
                      "device",
                      "all"
                    ]
                  }
                },
                "required": [
                  "scope"
                ]
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Signed out"
          }
        }
      }
    },
