                              "OPERATOR_ATTENDANT",
                              "ADMIN_SUPPORT",
                              "ADMIN_OPS",
                              "ADMIN_FINANCE",
                              "ADMIN_COMPLIANCE",
                              "SUPER_ADMIN"
                            ]
                          },
                          "operatorId": {
