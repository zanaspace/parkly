# Copy to .env.local. All three are public values (safe in the browser bundle).
# Local defaults match `supabase start` and the API dev server.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Supabase → Project Settings → API Keys → publishable key (or the anon key printed by `supabase start`).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_URL=http://localhost:4000

# Cloudflare Turnstile site key (public; ADR 0019). Empty = no security check on sign-in forms.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
