{
  "expo": {
    "name": "Parkly",
    "slug": "parkly",
    "scheme": "parkly",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.parkly.app"
    },
    "ios": {
      "bundleIdentifier": "com.parkly.app",
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-font",
      "expo-splash-screen",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Parkly uses the camera to scan the check-in poster at a car park.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Parkly uses your location to find car parks near you and to check you are at the car park when you check yourself in."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "zanas-team",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dce0bb26-acfd-457c-aeec-a3d43df9f899"
      }
    }
  }
}
