{
  "expo": {
    "name": "Parkly",
    "slug": "parkly",
    "scheme": "parkly",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.parkly.app"
    },
    "ios": {
      "bundleIdentifier": "com.parkly.app",
      "supportsTablet": false
    },
    "plugins": ["expo-router", "expo-font", "expo-splash-screen", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
