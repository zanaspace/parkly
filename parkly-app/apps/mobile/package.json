{
  "name": "@parkly/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "tunnel": "expo start --tunnel",
    "android": "expo start --android",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "eas-build-post-install": "cd ../.. && pnpm turbo run build --filter=@parkly/tokens --filter=@parkly/ui-native --filter=@parkly/contracts --filter=@parkly/domain",
    "test": "vitest run"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "0.4.2",
    "@expo-google-fonts/jetbrains-mono": "0.4.1",
    "@expo-google-fonts/plus-jakarta-sans": "0.4.2",
    "@expo/metro-runtime": "57.0.17",
    "@parkly/contracts": "workspace:*",
    "@parkly/domain": "workspace:*",
    "@parkly/tokens": "workspace:*",
    "@parkly/ui-native": "workspace:*",
    "@supabase/supabase-js": "2.117.3",
    "expo": "57.0.29",
    "expo-constants": "57.0.22",
    "expo-crypto": "57.0.4",
    "expo-font": "57.0.4",
    "expo-linking": "57.0.13",
    "expo-location": "57.0.22",
    "expo-router": "57.0.27",
    "expo-secure-store": "57.0.4",
    "expo-splash-screen": "57.0.10",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-url-polyfill": "4.0.0",
    "react-native-web": "0.21.4",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@parkly/config": "workspace:*",
    "@types/react": "19.2.18",
    "eslint": "10.12.0",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
