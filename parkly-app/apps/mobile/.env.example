# Copy to apps/mobile/.env and restart Expo. EXPO_PUBLIC_* values are bundled
# into the app, so only public values belong here — never a secret/service key.

# Supabase project URL and publishable (anon) key: Dashboard → Project Settings → API Keys.
# Local Supabase (`pnpm exec supabase start`) prints both.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Parkly API. Default http://localhost:4000 works in the browser preview only:
#   Android emulator → http://10.0.2.2:4000
#   Phone with Expo Go → http://<your PC's LAN IP>:4000 (e.g. http://192.168.100.120:4000)
EXPO_PUBLIC_API_URL=http://localhost:4000
