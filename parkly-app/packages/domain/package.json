{
  "name": "@parkly/domain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./money": {
      "types": "./dist/money/index.d.ts",
      "default": "./dist/money/index.js"
    },
    "./time": {
      "types": "./dist/time/index.d.ts",
      "default": "./dist/time/index.js"
    },
    "./plate": {
      "types": "./dist/plate/index.d.ts",
      "default": "./dist/plate/index.js"
    },
    "./codes": {
      "types": "./dist/codes/index.d.ts",
      "default": "./dist/codes/index.js"
    },
    "./authz": {
      "types": "./dist/authz/index.d.ts",
      "default": "./dist/authz/index.js"
    },
    "./phone": {
      "types": "./dist/phone/index.d.ts",
      "default": "./dist/phone/index.js"
    },
    "./lot": {
      "types": "./dist/lot/index.d.ts",
      "default": "./dist/lot/index.js"
    },
    "./operator": {
      "types": "./dist/operator/index.d.ts",
      "default": "./dist/operator/index.js"
    },
    "./availability": {
      "types": "./dist/availability/index.d.ts",
      "default": "./dist/availability/index.js"
    },
    "./discovery": {
      "types": "./dist/discovery/index.d.ts",
      "default": "./dist/discovery/index.js"
    },
    "./pricing": {
      "types": "./dist/pricing/index.d.ts",
      "default": "./dist/pricing/index.js"
    },
    "./booking": {
      "types": "./dist/booking/index.d.ts",
      "default": "./dist/booking/index.js"
    },
    "./qr": {
      "types": "./dist/qr/index.d.ts",
      "default": "./dist/qr/index.js"
    },
    "./checkin": {
      "types": "./dist/checkin/index.d.ts",
      "default": "./dist/checkin/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@parkly/config": "workspace:*",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "10.12.0",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  },
  "dependencies": {
    "@noble/ed25519": "3.0.1",
    "qrcode-generator": "2.0.4"
