{
  "name": "@parkly/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "postgres": "3.4.9",
    "uuid": "14.0.3"
  },
  "devDependencies": {
    "@parkly/config": "workspace:*",
    "@types/node": "22.20.5",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
