{
  "name": "@parkly/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@parkly/tokens": "workspace:*",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@parkly/config": "workspace:*",
    "@parkly/tokens": "workspace:*",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.18",
    "eslint": "10.12.0",
    "jsdom": "30.1.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
